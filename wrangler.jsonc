{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinevista",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Backing store for the ISR incremental cache (see open-next.config.ts).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "752ed2c4547945f68f6c7240a0b363c4"
    }
  ]
}
